{
  "expo": {
    "name": "SEF Student Profile",
    "slug": "SEF_mobile_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sef-student-profile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pk.org.sef.studentprofile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Required to upload student photos and documents.",
        "NSCameraUsageDescription": "Required to take student photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#1B6B4A"
      },
      "package": "pk.org.sef.studentprofile",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "backgroundColor": "#1B6B4A"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SEF Student Profile to access your photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B6B4A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}